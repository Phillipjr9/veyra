# Veyra API — environment configuration
# Copy to .env (the server loads it automatically) or export the variables.

# --- required in production ---
# HMAC secret for bearer tokens. Generate one: openssl rand -hex 32
TOKEN_SECRET=

# --- first Super Admin (created on boot if the email doesn't exist) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- optional ---
# HTTP port (default 8787)
PORT=8787
# SQLite database file (default server/veyra.db)
DB_PATH=server/veyra.db
# Allow a non-proxied browser origin (default *)
CORS_ORIGIN=

# --- reCAPTCHA on the anonymous auth routes (sign in / sign up / forgot) ---
# Off unless RECAPTCHA_SITE_KEY plus one provider credential is set, so dev and
# CI need no Google round-trip. The site key is public (it ships in the page);
# the secret and API key must never reach a browser.
#
# Pick ONE provider:
#   classic v3  → RECAPTCHA_SITE_KEY + RECAPTCHA_SECRET_KEY
#                 keys: https://www.google.com/recaptcha/admin  (choose "v3")
#   Enterprise  → RECAPTCHA_SITE_KEY + RECAPTCHA_PROJECT_ID + RECAPTCHA_API_KEY
#                 keys: Google Cloud console → reCAPTCHA Enterprise
#                 (this is what Firebase App Check builds on)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=

# Reject below this score. 1.0 = very likely human, 0.0 = very likely a bot.
# Start at 0.5, watch the "allowed a low score" log lines, then tune.
RECAPTCHA_MIN_SCORE=0.5
# Behaviour when Google itself is unreachable or our credentials are rejected.
# Default (unset) fails OPEN: an outage at Google must not lock customers out
# of their money. Set to 1 to fail closed and take the outage instead.
RECAPTCHA_FAIL_CLOSED=
# Optional comma-separated hostname allowlist, e.g. veyra.com,www.veyra.com
RECAPTCHA_HOSTNAMES=
# Verification timeout in ms (default 4000)
RECAPTCHA_TIMEOUT_MS=4000
# Override the verification endpoint (testing, or an egress proxy)
RECAPTCHA_VERIFY_URL=
