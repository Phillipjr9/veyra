# Veyra API — environment configuration
# Copy to .env (the server loads it automatically) or export the variables.

# --- required in production ---
# HMAC secret for bearer tokens. Generate one: openssl rand -hex 32
TOKEN_SECRET=

# --- first Super Admin (created on boot if the email doesn't exist) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- optional ---
# HTTP port (default 8787)
PORT=8787
# SQLite database file (default server/veyra.db)
DB_PATH=server/veyra.db
# Allow a non-proxied browser origin (default *)
CORS_ORIGIN=

# --- transactional email (password reset, application status, support) ---
# Off by default. Pick one HTTP provider: resend | postmark | sendgrid
# ("log" prints messages to the server console instead of sending).
MAIL_PROVIDER=
MAIL_API_KEY=
# A sender verified with your provider
MAIL_FROM="Veyra <no-reply@yourdomain.com>"
# Public origin of the app, used for links inside emails (no trailing slash)
APP_URL=https://app.yourdomain.com
# Optional shared inbox alerted about every new support request
SUPPORT_INBOX=

# --- public contact details shown on statements and the Contact page ---
# (build-time; read by Vite)
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_STREET=
VITE_COMPANY_CITY=
VITE_SUPPORT_EMAIL=
VITE_SALES_EMAIL=
# Leave empty until a staffed phone line exists
VITE_SUPPORT_PHONE=

# --- reCAPTCHA on the anonymous auth routes (sign in / sign up / forgot) ---
# Off unless RECAPTCHA_SITE_KEY plus one provider credential is set, so dev and
# CI need no Google round-trip. The site key is public (it ships in the page);
# the secret and API key must never reach a browser.
#
# Pick ONE provider:
#   classic v3  → RECAPTCHA_SITE_KEY + RECAPTCHA_SECRET_KEY
#                 keys: https://www.google.com/recaptcha/admin  (choose "v3")
#   Enterprise  → RECAPTCHA_SITE_KEY + RECAPTCHA_PROJECT_ID + RECAPTCHA_API_KEY
#                 keys: Google Cloud console → reCAPTCHA Enterprise
#                 (this is what Firebase App Check builds on)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=

# Reject below this score. 1.0 = very likely human, 0.0 = very likely a bot.
# Start at 0.5, watch the "allowed a low score" log lines, then tune.
RECAPTCHA_MIN_SCORE=0.5
# Behaviour when Google itself is unreachable or our credentials are rejected.
# Default (unset) fails OPEN: an outage at Google must not lock customers out
# of their money. Set to 1 to fail closed and take the outage instead.
RECAPTCHA_FAIL_CLOSED=
# Optional comma-separated hostname allowlist, e.g. veyra.com,www.veyra.com
RECAPTCHA_HOSTNAMES=
# Verification timeout in ms (default 4000)
RECAPTCHA_TIMEOUT_MS=4000
# Override the verification endpoint (testing, or an egress proxy)
RECAPTCHA_VERIFY_URL=

# --- passkeys (WebAuthn) ---
# Always on; there is no third party to configure. But a passkey is bound to a
# domain, so these MUST match your deployment or no passkey will verify.
#
# WEBAUTHN_RP_ID is a bare domain: no scheme, no port, no path. It must equal
# the site's domain or be a parent of it. Changing it later invalidates every
# passkey already registered, so pick the broadest domain you will ever serve
# from (veyra.com, not app.veyra.com) before members start enrolling.
# Defaults to the hostname of the first origin below.
WEBAUTHN_RP_ID=
# Comma list of full origins allowed to present a passkey (scheme + host +
# port). This is the phishing defence: an assertion collected anywhere else is
# refused. Defaults to the local dev ports.
WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:8787
# Name shown in the operating system's passkey prompt.
WEBAUTHN_RP_NAME=Veyra

# --- federated sign-in: Google / Apple / Microsoft, via Firebase Auth ---
# Off unless FIREBASE_PROJECT_ID is set. Firebase is only the credential step:
# the ID token is verified server-side, mapped onto an EXISTING member, and
# exchanged for a Veyra session. Revocation, RBAC and the audit trail are
# unchanged. See server/src/federated.ts for the full linking policy.
#
# All three values below are public (the Firebase web config ships in the page);
# there is no secret to protect here, and no service-account key is needed.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
# Defaults to <project-id>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=

# Which providers to offer: comma list of google, apple, microsoft.
# Defaults to "google" alone. Every provider you add is another door into an
# account, so each is opened deliberately — and must also be switched on in the
# Firebase console. The provider is read from the signed token, never from the
# request, so a caller cannot name one provider while presenting another's token.
#
# Apple note: members who pick "Hide My Email" arrive as a relay address that
# can never match an account. They get a 409 telling them to use "Share My
# Email" rather than a confusing "no account found".
FEDERATED_PROVIDERS=google

# Federated sign-in NEVER creates an account — opening one requires the full
# application (identity, tax ID, address, government ID). An unknown email is
# refused, not provisioned.
#
# Staff and Super Admin accounts are excluded by default: the console can move
# $10M, so unlocking it with a third-party identity widens the blast radius to
# whoever controls that provider account. Set to 1 only if your operators sign in
# through managed Workspace identities and you want that trade.
FEDERATED_ALLOW_STAFF=
# Clock-skew tolerance (seconds) and verification timeout (ms)
FIREBASE_LEEWAY_SEC=60
FIREBASE_TIMEOUT_MS=4000
# Override Google's JWKS endpoint (testing, or an egress proxy)
FIREBASE_JWKS_URL=

# ---------------------------------------------------------------------------
# Digital assets (crypto)
# ---------------------------------------------------------------------------
# ⚠ READ THIS BEFORE TURNING TRADING ON IN PRODUCTION.
#
# Holding digital assets for members and letting them buy and sell is
# "virtual currency business activity" under 23 NYCRR 200.2(q) — specifically
# storing/holding/maintaining custody of virtual currency on behalf of others,
# and buying and selling it as a customer business. In New York that requires
# a BitLicense or a limited-purpose trust charter. Veyra is a fintech product,
# not a chartered bank, so the NY Banking Law exemption does not apply.
#
# NYDFS issued cease-and-desist orders with $100K–$500K penalties to unlicensed
# platforms serving New Yorkers in early 2026. Talk to a fintech attorney before
# this is anything other than a demo.
#
# Unset = ON in development, OFF in production. That default is deliberate:
# the feature is built and demonstrable, and enabling it for real customers
# should be a decision someone made on purpose.
CRYPTO_TRADING_ENABLED=

# Price feed. Defaults to CoinGecko /coins/markets (free, keyless), which
# returns price, 1h/24h/7d change, market cap, volume and a 7-day sparkline
# for the top 100 coins in a single request — the holdings valuations and the
# whole markets page are served from that one call. A replacement must return
# the same array shape. Override for an egress proxy, a paid feed, or the
# offline stub in scripts/dev-prices.mjs.
CRYPTO_PRICES_URL=
# Cache lifetime for quotes (ms). Mind the quota: CoinGecko's free Demo tier
# allows 10,000 calls/month, and this endpoint alone bills
#   60s  -> 43,200/month   (free tier gone in ~7 days)
#   300s ->  8,640/month   (86% of the cap, nothing left for charts)
#   600s ->  4,320/month
CRYPTO_PRICES_TTL_MS=300000

# Oldest quote a trade may execute against (ms). Display degrades gracefully;
# trading fails closed, because filling an order at a stale price moves real
# money at the wrong rate.
#
# Leave unset. It defaults to 1.2x the cache TTL, and the two must not drift:
# a cache serving 300s-old quotes against a 120s trading limit refuses every
# trade in the last 60% of each cycle, with no visible symptom but failure.
CRYPTO_PRICE_MAX_AGE_MS=

# Candlestick history. {id} and {days} are substituted per request. Cached per
# (asset, range) with a TTL matched to candle width: 5min/30min/1h/6h for
# 1d/7d/30d/90d. Fetched only when someone opens a chart.
CRYPTO_OHLC_URL=
# Upstream request timeout (ms)
CRYPTO_PRICES_TIMEOUT_MS=4000

# Optional signup address suggestions — server only; never prefix with VITE_.
# Enable billing + Places API (New), restrict this key to Places API and your
# server egress IPs, and set Google Cloud quotas/budget alerts before enabling.
# Suggestions currently match the application's US-only address validation.
GOOGLE_MAPS_API_KEY=
