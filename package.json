{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:emails": "tsx scripts/build-emails.ts",
    "test": "npm run test:dashboard && npm run test:money-controls && tsx scripts/test-permissions.ts && node scripts/check-emails.mjs && node scripts/check-api-coverage.mjs && tsx server/scripts/audit-routes.ts && tsx server/scripts/test-api.ts && npm run test:addresses && npm run test:banking && npm run test:admin-members && npm run test:demo-payments",
    "server": "tsx server/src/index.ts",
    "test:api": "tsx server/scripts/test-api.ts",
    "check:routes": "node scripts/check-api-coverage.mjs",
    "audit:routes": "tsx server/scripts/audit-routes.ts",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "dev:all": "bash scripts/dev.sh",
    "test:e2e": "npm run build && playwright test",
    "typecheck:e2e": "tsc -p tsconfig.playwright.json",
    "verify": "npm test && npm run typecheck && npm run typecheck:e2e && npm run test:e2e",
    "test:dashboard": "tsx scripts/test-dashboard-analytics.ts && tsx server/scripts/test-ledger-analytics.ts",
    "test:money-controls": "tsx server/scripts/test-money-controls.ts",
    "test:addresses": "tsx server/scripts/test-addresses.ts",
    "test:banking": "tsx server/scripts/test-banking-update.ts",
    "test:admin-members": "tsx server/scripts/test-admin-members.ts",
    "test:demo-payments": "tsx server/scripts/test-demo-payments.ts",
    "test:e2e:demo": "npm run build && DEMO_PAYMENTS_ENABLED=1 playwright test tests/e2e/demo-payments.spec.ts tests/e2e/receive-hub.spec.ts",
    "server:demo": "DEMO_PAYMENTS_ENABLED=1 tsx server/src/index.ts",
    "test:e2e:charts": "npm run build && DEMO_PAYMENTS_ENABLED=1 playwright test tests/e2e/dashboard-responsive.spec.ts tests/e2e/ledger-charts.spec.ts",
    "test:e2e:account": "npm run build && ACCOUNT_LEDGER_ENABLED=1 playwright test tests/e2e/account-interface.spec.ts tests/e2e/ledger-charts.spec.ts tests/e2e/demo-payments.spec.ts tests/e2e/receive-hub.spec.ts"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "@types/express": "^5.0.6",
    "clsx": "2.1.1",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.52.0",
    "motion": "^13.5.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.19.17",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
